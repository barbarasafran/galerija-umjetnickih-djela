USE galerija_db;

DELIMITER //

CREATE PROCEDURE sp_kreiraj_admina(
    IN p_korisnicko_ime VARCHAR(50),
    IN p_lozinka_hash VARCHAR(255)
)
BEGIN
    INSERT INTO korisnik (korisnicko_ime, lozinka_hash, uloga)
    VALUES (p_korisnicko_ime, p_lozinka_hash, 'ADMINISTRATOR');
END //

DELIMITER ;

